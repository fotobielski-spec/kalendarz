{
  "name": "dokumenty-id-web",
  "private": true,
  "version": "0.1.0",
  "description": "Dokumenty ID Web — aplikacja webowa do zdjęć biometrycznych",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @dokumenty-id/api exec prisma generate",
    "db:migrate": "pnpm --filter @dokumenty-id/api exec prisma migrate dev",
    "db:studio": "pnpm --filter @dokumenty-id/api exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
