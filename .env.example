# === Aplikacja ===
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
ADMIN_BASE_URL=http://localhost:3001

# === API ===
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://dokumenty:dokumenty@localhost:5432/dokumenty_id
REDIS_URL=redis://localhost:6379

# === S3-compatible storage (MinIO lokalnie) ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=dokumenty-id
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# === Przetwarzanie biometryczne (wewnętrzne — packages/processing) ===
PROCESSING_MODE=mock

# === Signed URLs ===
SIGNED_URL_SECRET=change-me-in-production-min-32-chars
SIGNED_URL_TTL_SECONDS=900

# === Kolejka ===
QUEUE_PREFIX=dokumenty-id

# === Email (Resend / SES) ===
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# === Płatności (Stripe) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pln

# === Auth admin ===
ADMIN_JWT_SECRET=change-me-in-production-min-32-chars
ADMIN_SESSION_TTL_SECONDS=28800

# === Monitoring ===
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
