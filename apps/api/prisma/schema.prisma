// Schemat DB — rozwijany w etapach 1–5
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Sesja capture (kiosk → QR → mobile)
model CaptureSession {
  id        String   @id @default(uuid()) @db.Uuid
  qrToken   String   @unique @map("qr_token")
  status    String   @default("created")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  uploads CaptureUpload[]

  @@map("capture_sessions")
}

model CaptureUpload {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  storageKey  String   @map("storage_key")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  session CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("capture_uploads")
}

